# Copy this file to ".env" and fill in the values (see docs/).
# Every value here is PUBLIC by design — they ship inside the app.
# Never put a secret (Razorpay Key Secret, service-account keys) in this file.

# Razorpay — Dashboard → Account & Settings → API Keys → Key ID (rzp_test_… while testing)
EXPO_PUBLIC_RAZORPAY_KEY_ID=

# Google Apps Script web-app URL (ends with /exec) — orders, payment checks, analytics
EXPO_PUBLIC_APPS_SCRIPT_URL=

# Firebase (project: the-divine-tarot-2-project) — Project settings → Your apps → Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=the-divine-tarot-2-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=the-divine-tarot-2-project
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Google sign-in — the "Web client" OAuth client ID (…apps.googleusercontent.com)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
