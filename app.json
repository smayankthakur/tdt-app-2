{
  "expo": {
    "name": "The Divine Tarot",
    "slug": "the-divine-tarot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "divinetarot",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0710",
    "ios": {
      "bundleIdentifier": "com.thedivinetarotonline.app",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Choose a photo for your profile, your Personal Reading form or a support request.",
        "NSLocationWhenInUseUsageDescription": "Only if you allow it in Privacy settings: your approximate city is used to improve the app.",
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp",
          "credpay",
          "bhim",
          "mobikwik",
          "in.fampay.app",
          "amazonpay",
          "myairtel",
          "upi"
        ]
      }
    },
    "android": {
      "package": "com.thedivinetarotonline.app",
      "adaptiveIcon": {
        "backgroundColor": "#2A1454",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4A0E09",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E9C46A",
          "defaultChannel": "daily-card"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo for your profile, your Personal Reading form or a support request.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Only if you allow it in Privacy settings: your approximate city is used to improve the app.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "expo-localization",
      "expo-sharing",
      [
        "@sentry/react-native",
        {
          "organization": "sitelytc-digital-media",
          "project": "tdt-app",
          "url": "https://sentry.io/"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbecb0c4-3a12-4b6e-958b-0bfc9ff43be3"
      }
    }
  }
}
